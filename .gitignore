node_modules
dist
.DS_Store
*.local
*.tsbuildinfo

# Player-supplied audio. Store charts, not recordings.
public/audio/

# Secrets, listed before the first one exists rather than after.
.env
.env.*

# The chart library: files written by whoever is on the network. Guest-supplied
# text must not be swept into the host's repository by `git add -A`, and git
# history is permanent.
charts/

# Mutation-testing scratch. Validation copies src/ here, breaks it on purpose to
# prove its tests actually catch the defect, then deletes it. Transient by
# design — it was committed once by a test run that raced the agent creating it.
**/tests/.mutation/
